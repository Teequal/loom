{
  "name": "loom",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:lan": "next dev -H 0.0.0.0",
    "build": "next build",
    "start": "next start",
    "share": "bash scripts/share.sh",
    "share:build": "LOOM_DIST=.next-share next build",
    "share:update": "npm run share:build && pkill -f 'next start -p 3100' || true",
    "lint": "eslint",
    "loom": "tsx --env-file-if-exists=.env scripts/loom.ts",
    "db:generate": "drizzle-kit generate",
    "test:engine": "tsx scripts/engine-tests.ts",
    "test:world": "tsx --env-file=.env scripts/world-tests.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.1.0",
    "@huggingface/transformers": "^4.3.1",
    "@libsql/client": "^0.18.0",
    "drizzle-orm": "^0.45.4",
    "next": "16.4.2",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5"
  }
}
